{
  "name": "sravx-uniapp",
  "version": "0.1.0",
  "private": true,
  "description": "Sravx uni-app Vue 3 client",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni -p h5",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build -p h5 && node scripts/prepare-h5-static.mjs",
    "preview:h5": "cross-env UNI_INPUT_DIR=. vite preview --outDir dist/build/h5",
    "build:mp-weixin:payment-test": "npm run build:mp-weixin",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin && node scripts/verify-wechat-build.mjs",
    "build:mp-weixin:target-safe": "npm run build:mp-weixin",
    "build:mp-weixin:target-services": "npm run build:mp-weixin",
    "build:mp-weixin:target-orders-rehearsal": "npm run build:mp-weixin",
    "build:mp-weixin:structured-checkout-rehearsal": "npm run build:mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020520260821001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260821001",
    "@resvg/resvg-js": "^2.6.2",
    "cross-env": "^7.0.3",
    "vite": "5.2.8"
  }
}
