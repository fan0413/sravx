<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载物流信息...</text>
  </view>

  <block wx:else>
    <view class="card">
      <text class="title">物流信息</text>
      <view class="row between mt-16">
        <text class="label">快递公司</text>
        <text class="val">{{logisticsCompany || '--'}}</text>
      </view>
      <view class="row between mt-12">
        <text class="label">运单号</text>
        <view class="row">
          <text class="val">{{expressNo || '--'}}</text>
          <text wx:if="{{expressNo}}" class="copy-btn" bindtap="onCopyExpressNo">复制</text>
        </view>
      </view>
      <view class="row between mt-12">
        <text class="label">状态</text>
        <text class="val">{{status || '--'}}</text>
      </view>
    </view>

    <view class="card">
      <text class="title">物流详情</text>
      <view wx:if="{{expressNo}}" class="hint-wrap">
        <text class="hint">物流轨迹将在快递揽收后更新，请稍后查看。</text>
        <text class="hint">也可以在快递官方渠道搜索运单号 {{expressNo}} 查询最新进度。</text>
      </view>
      <view wx:else class="hint-wrap">
        <text class="hint">暂未生成运单号，请联系客服确认发货进度。</text>
      </view>
    </view>
  </block>
</view>
