.container {
  min-height: 100vh;
  background: var(--color-bg-secondary);
}

/* ====== Card Scroll ====== */

.card-scroll {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 220rpx);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ====== 16:9 Card Surface ====== */

.card-surface {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-float);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card-surface:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.35) 60%, transparent 100%);
}

.card-body {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.card-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

.card-model {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  font-weight: 300;
  letter-spacing: 1rpx;
}

/* ====== Info Bar ====== */

.info-bar {
  margin-top: 16rpx;
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-row-double {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-secondary);
  font-weight: 300;
  flex-shrink: 0;
}

.sn-code {
  font-size: 24rpx;
  color: var(--color-primary);
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 1rpx;
  font-weight: 400;
  text-align: right;
}

.warranty-label {
  position: relative;
  padding-left: 22rpx;
  flex-shrink: 0;
}

.warranty-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.warranty-label.lifetime::before { background: var(--color-accent); }
.warranty-label.valid::before { background: var(--color-success); }
.warranty-label.expired::before { background: var(--color-danger); }
.warranty-label.unknown::before { background: var(--color-border); }

.info-value {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 400;
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.info-value.lifetime {
  color: var(--color-accent);
  font-weight: 500;
}

/* ====== Card Actions ====== */

.card-actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.action-unbind {
  padding: 12rpx 32rpx;
  background: rgba(255, 59, 48, 0.06);
  border-radius: 100rpx;
}

.action-unbind text {
  font-size: 24rpx;
  color: var(--color-danger);
  font-weight: 400;
}

/* ====== Empty State ====== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
  box-shadow: var(--shadow-card);
}

.empty-img {
  width: 100%;
  height: 100%;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 300;
  text-align: center;
  padding: 0 80rpx;
}

/* ====== Bottom Bar ====== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

/* ====== Bind Modal ====== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
}

.modal-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  text-align: center;
  font-weight: 300;
}

.sn-input-wrap {
  margin: 40rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 4rpx;
  transition: border-color 0.2s ease;
}

.sn-input-wrap:focus-within {
  border-color: var(--color-accent);
}

.sn-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-primary);
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 88rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-bg-secondary);
}

.modal-cancel text {
  font-size: 30rpx;
  color: var(--color-secondary);
  font-weight: 400;
}

.modal-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-accent);
  transition: opacity 0.2s ease;
}

.modal-confirm:active {
  opacity: 0.85;
}

.modal-confirm text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.modal-confirm-disabled {
  opacity: 0.4;
}
