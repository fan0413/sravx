.container {
  min-height: 100vh;
  background: var(--color-bg-secondary);
}

/* ====== Card Scroll ====== */

.card-scroll {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 220rpx);
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.card-item { overflow: hidden; border-radius: 34rpx; background: #FFFFFF; box-shadow: 0 14rpx 34rpx rgba(29,29,31,.07); transition: opacity .2s ease; }
.card-item:active { opacity: .78; }
.card-surface { width: 100%; height: 458rpx; overflow: hidden; background: #ECEDEF; }
.card-bg { width: 100%; height: 100%; }
.tool-summary { padding: 28rpx 30rpx 30rpx; background: #FFFFFF; }
.card-name { display: block; color: var(--color-primary); font-size: 34rpx; font-weight: 700; letter-spacing: -.5rpx; }
/* ====== Empty State ====== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
  box-shadow: var(--shadow-card);
}

.empty-img {
  width: 100%;
  height: 100%;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 300;
  text-align: center;
  padding: 0 80rpx;
}

/* ====== Bottom Bar ====== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

/* ====== Bind Modal ====== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
}

.modal-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  text-align: center;
  font-weight: 300;
}

.sn-input-wrap {
  margin: 40rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 4rpx;
  transition: border-color 0.2s ease;
}

.sn-input-wrap:focus-within {
  border-color: var(--color-accent);
}

.sn-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-primary);
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 88rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-bg-secondary);
}

.modal-cancel text {
  font-size: 30rpx;
  color: var(--color-secondary);
  font-weight: 400;
}

.modal-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-accent);
  transition: opacity 0.2s ease;
}

.modal-confirm:active {
  opacity: 0.85;
}

.modal-confirm text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.modal-confirm-disabled {
  opacity: 0.4;
}
