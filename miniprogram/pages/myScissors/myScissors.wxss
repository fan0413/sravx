.container {
  min-height: 100vh;
  background: var(--color-bg-secondary);
}

/* ====== Card Scroll ====== */

.card-scroll {
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 220rpx);
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.card-item { overflow: hidden; border-radius: 34rpx; background: #FFFFFF; box-shadow: 0 14rpx 34rpx rgba(29,29,31,.07); transition: opacity .2s ease; }
.card-item:active { opacity: .78; }
.card-surface { width: 100%; height: 458rpx; overflow: hidden; background: #ECEDEF; }
.card-bg { width: 100%; height: 100%; }
.tool-summary { padding: 28rpx 30rpx 30rpx; background: #FFFFFF; }
.card-name { display: block; color: var(--color-primary); font-size: 34rpx; font-weight: 700; letter-spacing: -.5rpx; }
/* ====== Empty State ====== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
  box-shadow: var(--shadow-card);
}

.empty-img {
  width: 100%;
  height: 100%;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 300;
  text-align: center;
  padding: 0 80rpx;
}

/* ====== Bottom Bar ====== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

/* ====== Bind Modal ====== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
}

.modal-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-secondary);
  text-align: center;
  font-weight: 300;
}

.sn-input-wrap {
  margin: 40rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 4rpx;
  transition: border-color 0.2s ease;
}

.sn-input-wrap:focus-within {
  border-color: var(--color-accent);
}

.sn-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-primary);
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 88rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-bg-secondary);
}

.modal-cancel text {
  font-size: 30rpx;
  color: var(--color-secondary);
  font-weight: 400;
}

.modal-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-accent);
  transition: opacity 0.2s ease;
}

.modal-confirm:active {
  opacity: 0.85;
}

.modal-confirm text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.modal-confirm-disabled {
  opacity: 0.4;
}

/* Binding completion: compact brand welcome feedback */
.welcome-mask { position: fixed; inset: 0; z-index: 1300; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(17,17,18,.52); backdrop-filter: saturate(150%) blur(20rpx); -webkit-backdrop-filter: saturate(150%) blur(20rpx); }
.welcome-panel { position: relative; width: 100%; overflow: hidden; padding: 72rpx 46rpx 42rpx; border-radius: 38rpx; background: linear-gradient(145deg, #252322 0%, #161616 72%); box-shadow: 0 32rpx 80rpx rgba(0,0,0,.28); text-align: center; animation: welcome-panel-in .42s cubic-bezier(.2,.82,.25,1) both; }
.welcome-orbit { position: absolute; border: 1rpx solid rgba(225,205,169,.24); border-radius: 50%; pointer-events: none; }
.welcome-orbit-one { width: 420rpx; height: 420rpx; top: -218rpx; left: -120rpx; animation: welcome-orbit 2.8s ease-out infinite; }
.welcome-orbit-two { width: 310rpx; height: 310rpx; right: -156rpx; bottom: -160rpx; animation: welcome-orbit 2.8s .45s ease-out infinite; }
.welcome-mark-wrap { position: relative; width: 130rpx; height: 130rpx; margin: 0 auto 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #F8F5F0; box-shadow: 0 0 0 12rpx rgba(248,245,240,.1); animation: welcome-mark-in .58s .1s cubic-bezier(.16,.9,.25,1.25) both; }
.welcome-mark { width: 80rpx; height: 80rpx; }
.welcome-check { position: absolute; right: -4rpx; bottom: 2rpx; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #161616; border-radius: 50%; background: #C5A46B; }
.welcome-check text { color: #FFF; font-size: 25rpx; font-weight: 700; line-height: 1; }
.welcome-kicker { display: block; position: relative; font-size: 18rpx; font-weight: 700; letter-spacing: 2.7rpx; color: #D8BF92; }
.welcome-title { display: block; position: relative; margin-top: 20rpx; font-size: 42rpx; line-height: 1.22; font-weight: 700; letter-spacing: -1rpx; color: #FFF; }
.welcome-tool { display: block; position: relative; margin: 20rpx auto 0; color: rgba(255,255,255,.82); font-size: 26rpx; line-height: 1.4; }
.welcome-copy { display: block; position: relative; margin-top: 12rpx; color: rgba(255,255,255,.56); font-size: 22rpx; line-height: 1.5; }
.welcome-continue { position: relative; height: 84rpx; margin-top: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 99rpx; background: #F8F5F0; }
.welcome-continue:active { opacity: .72; transform: scale(.98); }
.welcome-continue text { color: #161616; font-size: 28rpx; font-weight: 650; }
@keyframes welcome-panel-in { from { opacity: 0; transform: translateY(36rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes welcome-mark-in { from { opacity: 0; transform: scale(.45) rotate(-18deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
@keyframes welcome-orbit { 0% { opacity: 0; transform: scale(.8); } 30% { opacity: 1; } 100% { opacity: 0; transform: scale(1.12); } }