<view class="container">
  <view wx:if="{{scissors.length > 0}}" class="card-scroll">
    <view wx:for="{{scissors}}" wx:key="sn" class="card-item" bindtap="onCardTap" data-item="{{item}}">
      <view class="card-surface">
        <image class="card-bg" src="{{item.card_image || item.image}}" mode="aspectFill" lazy-load />
      </view>
      <view class="tool-summary">
        <text class="card-name ellipsis">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-icon">
      <image class="empty-img" src="/images/logo.png" mode="aspectFit" />
    </view>
    <text class="empty-title">暂无绑定剪刀</text>
    <text class="empty-desc">绑定您的 Sravx 剪刀，查看专属卡片与保修信息</text>
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="btn-primary" bindtap="onShowBindModal">
      <text>新增绑定</text>
    </view>
  </view>

  <view wx:if="{{showWelcome}}" class="welcome-mask">
    <view class="welcome-panel" catchtap="">
      <view class="welcome-orbit welcome-orbit-one"></view>
      <view class="welcome-orbit welcome-orbit-two"></view>
      <view class="welcome-mark-wrap">
        <image class="welcome-mark" src="/images/logo.png" mode="aspectFit" />
        <view class="welcome-check"><text>✓</text></view>
      </view>
      <text class="welcome-kicker">THE TOOLS YOU DESERVE.</text>
      <text class="welcome-title">工具已加入你的档案</text>
      <text class="welcome-tool ellipsis">{{welcomeToolName}}</text>
      <text class="welcome-copy">专属工具信息与保修服务现已可用</text>
      <view class="welcome-continue" bindtap="onWelcomeContinue"><text>查看工具档案</text></view>
    </view>
  </view>
  <view wx:if="{{showBindModal}}" class="modal-mask" bindtap="onCloseBindModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">绑定剪刀</text>
      <text class="modal-desc">请输入剪刀 SN 序列号</text>
      <view class="sn-input-wrap">
        <input
          class="sn-input"
          placeholder="例如：以SVB、SVP、SVM开头的SN码"
          placeholder-style="color:#C7C7CC;font-size:28rpx;line-height:88rpx;"
          value="{{snInput}}"
          bindinput="onSnInput"
          maxlength="20"
          focus="{{showBindModal}}"
        />
      </view>
      <view class="modal-actions">
        <view class="modal-cancel" bindtap="onCloseBindModal">
          <text>取消</text>
        </view>
        <view class="modal-confirm {{snInput ? '' : 'modal-confirm-disabled'}}" bindtap="onConfirmBind">
          <text>{{binding ? '验证中...' : '确认绑定'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
