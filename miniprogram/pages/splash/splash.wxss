.splash {
  width: 750rpx;
  min-height: 100%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
}

.skip-btn {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  right: 32rpx;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  background-color: rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  z-index: 200;
}

.skip-btn text {
  font-size: 24rpx;
  color: #86868B;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 320rpx;
  height: 400rpx;
}

