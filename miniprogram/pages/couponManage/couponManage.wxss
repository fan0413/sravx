.page {
  min-height: 100%;
  background: #F2F2F7;
  padding: 20rpx;
  box-sizing: border-box;
}

.loading-tip {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  margin: 6rpx 0 18rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-bottom: 30rpx;
}

.coupon-card {
  background: #f2f3f5;
  border-radius: 16rpx;
  display: flex;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
}

.card-left {
  width: 150rpx;
  background: linear-gradient(180deg, #2563eb, #1d4ed8);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 8rpx;
  box-sizing: border-box;
}

.coupon-card.used .card-left {
  background: linear-gradient(180deg, #9ca3af, #6b7280);
}

.coupon-card.expired .card-left {
  background: linear-gradient(180deg, #9ca3af, #6b7280);
}

.type {
  font-size: 18rpx;
  opacity: 0.9;
  font-weight: 600;
}

.value {
  margin-top: 4rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
}

.condition {
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.9;
  font-weight: 600;
}

.card-right {
  flex: 1;
  padding: 10rpx 10rpx 56rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  overflow: hidden;
  min-height: 176rpx;
  position: relative;
}

.line-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.status-badge {
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.status-badge.unused {
  color: #0b7a55;
  background: #dcfce7;
}

.status-badge.used {
  color: #4b5563;
  background: #e5e7eb;
}

.status-badge.expired {
  color: #9ca3af;
  background: #f3f4f6;
}

.meta {
  font-size: 18rpx;
  color: #6b7280;
  line-height: 1.35;
}

.note-text {
  display: block;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-row {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  justify-content: flex-end;
}

.primary-btn {
  margin: 0;
  min-width: 138rpx;
  height: 42rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.primary-btn {
  border: none;
  background: #111827;
  color: #ffffff;
}

.primary-btn::after {
  border: none;
}

.primary-btn.disabled {
  background: #d1d5db;
  color: #6b7280;
}

.empty-box {
  margin-top: 8rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 72rpx 20rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.empty-desc {
  margin-top: 10rpx;
  display: block;
  font-size: 22rpx;
  color: #6b7280;
}
