.container {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
}

.points-card {
  background: #1d1d1f;
  border-radius: 20rpx;
  padding: 34rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 190rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.18);
}

.points-card-accent {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 1;
}

.points-card.level-normal {
  background: linear-gradient(135deg, #232326 0%, #151518 100%);
}
.points-card.level-normal .points-card-accent {
  background:
    radial-gradient(140% 120% at 10% 10%, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 55%),
    radial-gradient(140% 120% at 100% 0%, rgba(156, 163, 175, 0.18) 0%, rgba(156, 163, 175, 0) 58%);
}

.points-card.level-silver {
  background: linear-gradient(135deg, #26262a 0%, #141417 100%);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}
.points-card.level-silver .points-card-accent {
  background:
    radial-gradient(140% 120% at 88% 10%, rgba(232, 234, 237, 0.18) 0%, rgba(232, 234, 237, 0) 55%),
    linear-gradient(110deg, rgba(255, 255, 255, 0) 0%, rgba(232, 234, 237, 0.08) 35%, rgba(255, 255, 255, 0) 70%);
}

.points-card.level-gold {
  background: linear-gradient(135deg, #221f17 0%, #141417 100%);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.22);
}
.points-card.level-gold .points-card-accent {
  background:
    radial-gradient(140% 130% at 88% 35%, rgba(245, 166, 35, 0.22) 0%, rgba(245, 166, 35, 0) 60%),
    radial-gradient(120% 120% at 10% 10%, rgba(255, 224, 130, 0.12) 0%, rgba(255, 224, 130, 0) 55%),
    repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.06) 0, rgba(255, 255, 255, 0.06) 1rpx, rgba(255, 255, 255, 0) 8rpx, rgba(255, 255, 255, 0) 18rpx);
  opacity: 0.95;
}

.points-card.level-diamond {
  background: linear-gradient(135deg, #1b1b23 0%, #121216 100%);
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.24);
}
.points-card.level-diamond .points-card-accent {
  background:
    radial-gradient(140% 120% at 82% 18%, rgba(147, 112, 219, 0.22) 0%, rgba(147, 112, 219, 0) 58%),
    radial-gradient(120% 120% at 18% 0%, rgba(123, 104, 238, 0.16) 0%, rgba(123, 104, 238, 0) 60%),
    linear-gradient(110deg, rgba(255, 255, 255, 0) 0%, rgba(240, 230, 255, 0.07) 38%, rgba(255, 255, 255, 0) 78%);
}

.points-card.level-black-diamond {
  background: linear-gradient(135deg, #171719 0%, #0f0f12 100%);
  border-color: rgba(255, 255, 255, 0.1);
  box-shadow: 0 22rpx 56rpx rgba(0, 0, 0, 0.28);
}
.points-card.level-black-diamond .points-card-accent {
  background:
    radial-gradient(160% 140% at 90% 10%, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 60%),
    radial-gradient(120% 120% at 10% 100%, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 62%);
  opacity: 0.85;
}

.points-card.level-supreme {
  background: linear-gradient(135deg, #141417 0%, #0f0f12 100%);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 26rpx 64rpx rgba(0, 0, 0, 0.3);
}
.points-card.level-supreme .points-card-accent {
  background:
    radial-gradient(160% 140% at 88% 22%, rgba(236, 72, 153, 0.18) 0%, rgba(236, 72, 153, 0) 60%),
    radial-gradient(140% 130% at 20% 0%, rgba(139, 92, 246, 0.16) 0%, rgba(139, 92, 246, 0) 62%),
    linear-gradient(110deg, rgba(255, 255, 255, 0) 0%, rgba(255, 241, 250, 0.08) 40%, rgba(255, 255, 255, 0) 80%);
}

.user-left {
  display: flex;
  align-items: center;
  max-width: 60%;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #2c2c2e;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.username {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.member-level {
  color: #d2d2d7;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.points-card.level-gold .member-level {
  color: rgba(255, 248, 225, 0.88);
}
.points-card.level-diamond .member-level {
  color: rgba(240, 230, 255, 0.88);
}
.points-card.level-black-diamond .member-level {
  color: rgba(245, 245, 245, 0.88);
}
.points-card.level-supreme .member-level {
  color: rgba(255, 241, 250, 0.9);
}

.points-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  position: relative;
  z-index: 1;
}

.points-label {
  color: #d2d2d7;
  font-size: 24rpx;
}

.points-card.level-gold .points-label {
  color: rgba(255, 248, 225, 0.84);
}
.points-card.level-diamond .points-label {
  color: rgba(240, 230, 255, 0.84);
}
.points-card.level-black-diamond .points-label {
  color: rgba(245, 245, 245, 0.84);
}
.points-card.level-supreme .points-label {
  color: rgba(255, 241, 250, 0.86);
}

.points-value {
  color: #fff;
  font-size: 54rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.state-text {
  color: #86868b;
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-wrap {
  display: inline-flex;
  align-items: center;
  padding-bottom: 4rpx;
}

.category-item {
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: #ffffff;
  color: #5b5b62;
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.category-item.active {
  background: #1d1d1f;
  color: #ffffff;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
  position: relative;
}

.item-image {
  width: 100%;
  height: 260rpx;
  background: #f2f2f2;
}

.item-name {
  display: block;
  font-size: 28rpx;
  color: #1d1d1f;
  line-height: 1.3;
  padding: 14rpx 14rpx 8rpx;
  min-height: 74rpx;
}

.item-points {
  display: block;
  font-size: 26rpx;
  color: #b98f4a;
  padding: 0 14rpx;
}

.level-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 19rpx;
  background: rgba(29, 29, 31, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-tag text {
  color: #fff;
  font-size: 20rpx;
}

.level-tag-lock {
  background: rgba(168, 120, 42, 0.85);
}

.item-lock-text {
  display: block;
  color: #c45a5a;
  font-size: 21rpx;
  padding: 4rpx 14rpx 0;
}
