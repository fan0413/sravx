.shop-container { height: 100%; background: #F2F2F7; }.shop-scroll { height: 100%; }.shop-intro { padding: 54rpx 32rpx 38rpx; }.shop-title { display: block; color: var(--color-primary); font-size: 56rpx; line-height: 1.08; font-weight: 720; letter-spacing: -1.6rpx; }.shop-subtitle { display: block; margin-top: 15rpx; color: var(--color-secondary); font-size: 27rpx; }.series-showcase-scroll { white-space: nowrap; }.series-showcase-row { display: flex; gap: 20rpx; padding: 0 28rpx 20rpx; }.series-showcase-card { width: 620rpx; min-width: 620rpx; overflow: hidden; border-radius: 34rpx; background: #FFF; box-shadow: 0 14rpx 36rpx rgba(29,29,31,.08); white-space: normal; transition: transform .16s ease, opacity .16s ease; }.series-showcase-card:active, .explore-card:active, .tool-chip:active, .sub-chip:active, .shop-product-card:active { transform: scale(.97); opacity: .78; }.series-media { width: 620rpx; height: 390rpx; background: #ECEDEF; }.series-image { width: 100%; height: 100%; }.series-copy { min-height: 210rpx; padding: 30rpx 32rpx 24rpx; }.series-material { display: block; color: var(--color-accent); font-size: 21rpx; font-weight: 700; letter-spacing: 1.8rpx; }.series-name { display: block; margin-top: 12rpx; color: var(--color-primary); font-size: 43rpx; line-height: 1.15; font-weight: 720; letter-spacing: -.9rpx; }.series-caption { display: block; margin-top: 12rpx; color: var(--color-secondary); font-size: 27rpx; }.series-count { display: block; margin-top: 12rpx; color: var(--color-secondary); font-size: 22rpx; }.series-action { min-height: 116rpx; padding: 20rpx 32rpx; display: flex; align-items: center; justify-content: center; border-top: 1rpx solid #E9E1D7; background: #F8F5F0; color: var(--color-primary); font-size: 28rpx; font-weight: 650; }.explore-section { padding: 52rpx 28rpx 0; }.explore-title { display: block; margin: 0 4rpx 24rpx; color: var(--color-primary); font-size: 42rpx; font-weight: 720; letter-spacing: -.8rpx; }.explore-card { min-height: 194rpx; padding: 24rpx 28rpx; display: flex; align-items: center; border-radius: 28rpx; background: #FFF; box-shadow: 0 10rpx 28rpx rgba(29,29,31,.055); transition: transform .16s ease, opacity .16s ease; }.explore-icon { width: 116rpx; height: 116rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #F2F2F7; }.explore-grid { width: 46rpx; height: 46rpx; border: 3rpx solid var(--color-accent); border-radius: 12rpx; position: relative; }.explore-grid::after { content: ''; width: 3rpx; height: 38rpx; background: var(--color-accent); position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); }.explore-copy { flex: 1; min-width: 0; margin-left: 22rpx; }.explore-copy text:first-child { display: block; color: var(--color-primary); font-size: 30rpx; font-weight: 650; }.explore-copy text:last-child { display: block; margin-top: 9rpx; color: var(--color-secondary); font-size: 24rpx; }.explore-arrow { width: 16rpx; height: 16rpx; margin-left: 18rpx; border-right: 2rpx solid #C7C7CC; border-bottom: 2rpx solid #C7C7CC; transform: rotate(-45deg); }.catalog-nav { padding: 26rpx 32rpx 10rpx; display: flex; align-items: center; gap: 12rpx; color: var(--color-accent); font-size: 27rpx; }.catalog-back { width: 15rpx; height: 15rpx; border-left: 2rpx solid var(--color-accent); border-bottom: 2rpx solid var(--color-accent); transform: rotate(45deg); }.catalog-intro { padding: 30rpx 32rpx 40rpx; }.catalog-series { display: block; color: var(--color-primary); font-size: 52rpx; line-height: 1.1; font-weight: 720; letter-spacing: -1.3rpx; }.catalog-material { display: block; margin-top: 14rpx; color: var(--color-secondary); font-size: 27rpx; }.tool-section { margin-top: 4rpx; }.section-heading { display: block; padding: 0 32rpx 20rpx; color: var(--color-primary); font-size: 32rpx; font-weight: 700; }.tool-scroll, .sub-scroll { white-space: nowrap; }.tool-row { display: flex; gap: 14rpx; padding: 0 28rpx; }.tool