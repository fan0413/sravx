.shop-container {
  display: flex;
  height: 100%;
  background: #FFFFFF;
}

/* ====== Sidebar ====== */

.sidebar {
  width: 156rpx;
  height: 100%;
  background: var(--color-bg-secondary);
  flex-shrink: 0;
}

.sidebar-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 24rpx;
  color: var(--color-secondary);
  position: relative;
  transition: all 0.2s ease;
}

.sidebar-active {
  background: #FFFFFF;
  color: var(--color-primary);
  font-weight: 600;
}

.sidebar-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: var(--color-accent);
  border-radius: 0 6rpx 6rpx 0;
}

/* ====== Product Area ====== */

.product-area {
  flex: 1;
  height: 100%;
  background: #FFFFFF;
}

/* ====== Section Anchor & Title ====== */

.section-anchor {
  padding: 28rpx 20rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

/* ====== Product Grid (3-col) ====== */

.area-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx 14rpx;
}

.shop-product-card {
  width: 31.8%;
  margin: 0 0.75% 18rpx;
  padding-bottom: 4rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.shop-product-card:active {
  opacity: 0.85;
}

.shop-product-img-wrap {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  background: #f5f5f5;
}

.shop-product-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.shop-product-no-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.shop-product-no-img text {
  font-size: 22rpx;
  color: #ccc;
}

.shop-product-name {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.4;
  text-align: center;
  padding: 6rpx 8rpx 4rpx;
  min-height: 58rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ====== Empty & Loading States ====== */

.empty-sidebar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 108rpx;
  font-size: 24rpx;
  color: var(--color-secondary);
}

.section-empty {
  padding: 16rpx 20rpx 34rpx;
  font-size: 24rpx;
  color: var(--color-secondary);
}

.loading-state,
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: var(--color-secondary);
}
