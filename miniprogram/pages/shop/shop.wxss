.shop-container { height: 100%; background: #F2F2F7; }.shop-scroll { height: 100%; }.shop-intro { padding: 46rpx 32rpx 36rpx; }.shop-title { display: block; color: var(--color-primary); font-size: 56rpx; line-height: 1.1; font-weight: 720; letter-spacing: -1.5rpx; }.shop-subtitle { display: block; margin-top: 14rpx; color: var(--color-secondary); font-size: 27rpx; }.series-section, .tool-section { margin-top: 10rpx; }.section-heading { padding: 0 32rpx 20rpx; color: var(--color-primary); font-size: 32rpx; font-weight: 700; letter-spacing: -.4rpx; }.series-scroll, .tool-scroll, .sub-scroll { white-space: nowrap; }.series-row { display: flex; gap: 16rpx; padding: 0 28rpx 28rpx; }.series-card { width: 226rpx; min-width: 226rpx; min-height: 180rpx; padding: 24rpx 22rpx; display: flex; flex-direction: column; justify-content: flex-end; border: 1rpx solid transparent; border-radius: 26rpx; background: #FFF; box-shadow: 0 8rpx 22rpx rgba(29,29,31,.045); transition: transform .16s ease, opacity .16s ease; }.series-card:active, .tool-chip:active, .sub-chip:active, .shop-product-card:active { transform: scale(.96); opacity: .78; }.series-active { border-color: var(--color-accent); background: #F8F5F0; }.series-material { display: block; margin-bottom: auto; color: var(--color-accent); font-size: 20rpx; font-weight: 700; letter-spacing: 1.6rpx; }.series-name { display: block; color: var(--color-primary); font-size: 34rpx; font-weight: 720; letter-spacing: -.5rpx; }.series-caption { display: block; margin-top: 8rpx; color: var(--color-secondary); font-size: 22rpx; }.tool-row { display: flex; gap: 14rpx; padding: 0 28rpx; }.tool-chip, .sub-chip { min-width: max-content; padding: 17rpx 24rpx; border-radius: 99rpx; background: #FFF; color: var(--color-secondary); font-size: 25rpx; transition: transform .16s ease, opacity .16s ease; }.tool-active { background: var(--color-primary); color: #FFF; font-weight: 650; }.sub-row { display: flex; gap: 12rpx; padding: 18rpx 28rpx 4rpx; }.sub-chip { padding: 13rpx 20rpx; background: transparent; border: 1rpx solid #D7D7DC; font-size: 23rpx; }.sub-active { border-color: var(--color-accent); background: #F8F5F0; color: var(--color-accent-dark); font-weight: 650; }.catalog-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 54rpx 32rpx 22rpx; }.catalog-title { color: var(--color-primary); font-size: 40rpx; font-weight: 720; letter-spacing: -.7rpx; }.catalog-count { color: var(--color-secondary); font-size: 24rpx; }.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; padding: 0 28rpx; }.shop-product-card { overflow: hidden; border-radius: 26rpx; background: #FFF; box-shadow: 0 10rpx 28rpx rgba(29,29,31,.06); transition: transform .16s ease, opacity .16s ease; }.shop-product-img-wrap { width: 100%; aspect-ratio: 1 / 1; background: #ECEDEF; }.shop-product-img { width: 100%; height: 100%; }.product-copy { min-height: 126rpx; padding: 20rpx; }.product-category { display: block; margin-bottom: 8rpx; color: var(--color-accent); font-size: 20rpx; font-weight: 650; }.shop-product-name { color: var(--color-primary); font-size: 27rpx; font-weight: 650; line-height: 1.35; }.loading-state, .empty-state { display: flex; align-items: center; justify-content: center; padding: 120rpx 40rpx; color: var(--color-secondary); font-size: 27rpx; text-align: center; }
