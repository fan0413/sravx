<view class="container">
  <view class="nav-bar" style="height: {{navBarHeight}}rpx;">
    <view class="nav-back" bindtap="onBack"><view class="back-arrow"></view></view>
  </view>

  <scroll-view scroll-y class="detail-scroll" style="padding-top: {{navBarHeight}}rpx;" enhanced show-scrollbar="{{false}}">
    <view class="gallery">
      <swiper class="gallery-swiper" autoplay="{{false}}" circular bindchange="onSwiperChange">
        <swiper-item wx:for="{{images}}" wx:key="*this"><view class="gallery-frame"><image class="gallery-img" src="{{item}}" mode="aspectFit" /></view></swiper-item>
      </swiper>
      <view wx:if="{{images.length > 1}}" class="gallery-counter"><text>{{swiperCurrent + 1}} / {{images.length}}</text></view>
    </view>

    <view class="info-section">
      <text class="product-eyebrow">SRAVX PROFESSIONAL TOOLS</text>
      <text class="product-title">{{product.name}}</text>
      <text class="product-subtitle">{{product.desc}}</text>
      <view class="price-row"><text class="price-label">售价</text><text class="price">¥{{displayPrice}}</text></view>
    </view>

    <view class="configuration-section">
      <view class="configuration-head"><text class="configuration-title">型号：选择适合你的工具。</text></view>
      <view class="model-list">
        <view wx:for="{{modelOptions}}" wx:key="name" class="model-option {{selectedModel === item.name ? 'model-option-selected' : ''}}" data-index="{{index}}" bindtap="onModelTap">
          <view><text class="model-name">{{item.name}}</text><text wx:if="{{item.sku}}" class="model-sku">{{item.sku}}</text></view>
          <text class="model-price">¥{{item.priceText}}</text>
        </view>
      </view>

      <view class="configuration-block">
        <text class="configuration-title">外观：选择你喜欢的颜色。</text>
        <view class="color-list">
          <view wx:for="{{colorOptions}}" wx:key="name" class="color-option {{selectedColor === item.name ? 'color-option-selected' : ''}}" data-index="{{index}}" bindtap="onColorOptionTap">
            <view class="color-swatch" style="background: {{item.swatch}};"></view>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="configuration-block protect-block">
        <text class="configuration-title">SRAVX Protect</text>
        <text class="protect-intro">延长保修期，获得专属换购权益。</text>
        <view class="protect-option {{protectSelected ? '' : 'protect-option-selected'}}" data-value="false" bindtap="onProtectTap">
          <view><text class="protect-option-title">不添加 SRAVX Protect</text><text class="protect-option-desc">保留产品原有保修服务。</text></view>
          <view class="option-radio"></view>
        </view>
        <view class="protect-option {{protectSelected ? 'protect-option-selected' : ''}}" data-value="true" bindtap="onProtectTap">
          <view><text class="protect-option-title">添加 SRAVX Protect</text><text class="protect-option-desc">具体适用条件与服务规则以下单页公示为准。</text></view>
          <view class="option-radio"></view>
        </view>
      </view>
    </view>

    <view class="divider-thick"></view>
    <view class="spec-section">
      <view class="spec-header"><text class="product-eyebrow">TECHNICAL DETAILS</text><text class="spec-title">主要参数</text></view>
      <view class="spec-table">
        <view class="spec-row"><text class="spec-label">核心材质</text><text class="spec-value">{{mainParams.coreMaterial}}</text></view>
        <view class="spec-row"><text class="spec-label">手柄材质</text><text class="spec-value">{{mainParams.handleMaterial}}</text></view>
        <view class="spec-row"><text class="spec-label">尺寸</text><text class="spec-value">{{mainParams.size}}</text></view>
        <view class="spec-row"><text class="spec-label">重量</text><text class="spec-value">{{mainParams.weight}}</text></view>
        <view class="spec-row"><text class="spec-label">保修期</text><text class="spec-value">{{mainParams.warrantyPeriod}}</text></view>
      </view>
    </view>

    <view wx:if="{{detailImages.length > 0}}" class="divider-thick"></view>
    <view wx:if="{{detailImages.length > 0}}" class="detail-image-section">
      <view class="detail-image-header"><text class="product-eyebrow">PRODUCT STORY</text><text class="detail-image-title">详情展示</text></view>
      <view class="detail-image-list"><image wx:for="{{detailImages}}" wx:key="*this" class="detail-image-item" src="{{item}}" mode="widthFix" lazy-load /></view>
    </view>
    <view style="height: 190rpx;"></view>
  </scroll-view>

  <view class="bottom-bar safe-bottom">
    <view class="bottom-price-summary"><text class="bottom-price-label">已选价格</text><text class="bottom-price">¥{{displayPrice}}</text></view>
    <view class="bag-btn bag-btn-primary" bindtap="onAddToBag"><text>加入购物袋</text></view>
  </view>
</view>
