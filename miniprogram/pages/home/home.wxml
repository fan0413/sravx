<view class="container">
  <view class="search-bar" style="padding-top: {{navBarTop}}rpx; padding-right: {{capsuleRight}}rpx;">
    <view class="brand-lockup" style="height: {{navBarHeight}}rpx;" bindtap="onSearchTap">
      <image class="brand-mark" src="/images/logo.png" mode="aspectFit" />
      <text class="brand-name">SRAVX</text>
    </view>
    <view class="search-inner" style="height: {{navBarHeight}}rpx;" bindtap="onSearchTap">
      <view class="search-icon">
        <view class="search-circle"></view>
        <view class="search-handle"></view>
      </view>
      <text class="search-placeholder">搜索产品与服务</text>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="padding-top: {{scrollPaddingTop}}rpx;" enhanced show-scrollbar="{{false}}">
    <view class="intro-block">
      <text class="page-title">产品</text>

    </view>

    <scroll-view class="series-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
      <view class="series-row">
        <view wx:for="{{homeSeries}}" wx:key="key" class="series-card" bindtap="onSeriesTap" data-series="{{item.key}}">
          <view class="series-image-wrap">
            <image class="series-image" src="{{item.image}}" mode="aspectFit" lazy-load />
          </view>
          <view class="series-copy">
            <text class="series-material">{{item.material}}</text>
            <text class="series-name">{{item.name}}</text>
            <text class="series-caption">{{item.caption}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="accessory-block">
      <text class="section-label">按需求选购</text>
      <scroll-view class="chip-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
        <view class="chip-row">
          <view class="filter-chip chip-selected" bindtap="onBrowseTap"><text>专业剪刀</text></view>
          <view class="filter-chip" bindtap="onBrowseTap"><text>日常护理</text></view>
          <view class="filter-chip" bindtap="onBrowseTap"><text>收纳与保养</text></view>
          <view class="filter-chip" bindtap="onBrowseTap"><text>新品上架</text></view>
        </view>
      </scroll-view>
    </view>

    <view class="section-header feature-header">
      <view>
        <text class="section-kicker">FEATURED FOR GROOMERS</text>
        <text class="section-title">认识新伙伴</text>
      </view>
      <text class="section-more" bindtap="onBrowseTap">查看全部</text>
    </view>

    <view class="swiper-wrap">
      <swiper class="banner-swiper" autoplay circular interval="4000" duration="500" bindchange="onSwiperChange">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item" bindtap="onBrowseTap">
            <view class="banner-media">
              <image class="banner-img" src="{{item.image || '/images/logo.png'}}" mode="aspectFill" />
            </view>
            <view class="banner-detail">
              <text class="banner-eyebrow">SRAVX PROFESSIONAL TOOLS</text>
              <text class="banner-title">{{item.title}}</text>
              <text class="banner-subtitle">{{item.subtitle || '为精准、稳定的专业工作而设计'}}</text>
            </view>
            <view class="banner-footer">
              <text class="banner-price">专业美容工具系列</text>
              <view class="banner-action"><text>查看系列</text></view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="swiper-dots">
        <view wx:for="{{banners}}" wx:key="id" class="dot {{swiperCurrent === index ? 'dot-active' : ''}}"></view>
      </view>
    </view>

    <view class="section-header product-header">
      <view>
        <text class="section-kicker">CURATED TOOLS</text>
        <text class="section-title">为工作而生</text>
      </view>
      <text class="section-more" bindtap="onBrowseTap">查看全部</text>
    </view>

    <view wx:if="{{loading}}" class="loading-state"><text>正在准备产品目录</text></view>
    <view wx:elif="{{products.length === 0}}" class="empty-state"><text>新品正在整理中</text></view>

    <scroll-view wx:else class="product-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
      <view class="product-track">
        <view wx:for="{{products}}" wx:key="id" class="product-card" bindtap="onProductTap" data-id="{{item.id}}">
          <view class="product-img-wrap">
            <image class="product-img" src="{{item.image || item.cover_image}}" mode="aspectFill" lazy-load />
            <view class="product-index"><text>{{index + 1}}</text></view>
          </view>
          <view class="product-info">
            <text class="product-name ellipsis-2">{{item.short_name}}</text>
            <text class="product-desc ellipsis">{{item.desc}}</text>
          </view>
          <view class="product-footer">
            <text class="product-price">¥{{item.price}} 起</text>
            <view class="product-action"><text>查看</text></view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="service-feature-section">
      <view class="service-feature-head">
        <text class="service-feature-heading">SRAVX 有特色</text>
      </view>
      <swiper class="service-feature-swiper" circular duration="360" bindchange="onFeatureChange">
        <swiper-item wx:for="{{serviceFeatures}}" wx:key="key">
          <view class="service-feature-slide">
            <view class="service-feature-symbol {{item.theme}}">
              <view wx:if="{{item.key === 'custom'}}" class="laser-marker-icon" aria-label="激光打标机">
                <view class="laser-marker-frame"></view>
                <view class="laser-marker-gantry"></view>
                <view class="laser-marker-head"><view class="laser-marker-lens"></view></view>
                <view class="laser-marker-bed"><view class="laser-marker-workpiece"><view class="laser-marker-focus"><view class="laser-marker-focus-horizontal"></view><view class="laser-marker-focus-vertical"></view></view></view></view>
              </view>
              <view wx:elif="{{item.key === 'protect'}}" class="protect-mark" aria-label="SRAVX Protect">
                <view class="protect-mark-shield"></view>
                <view class="protect-mark-crest"></view>
                <view class="protect-mark-check"></view>
              </view>
              <text wx:else>{{item.symbol}}</text>
            </view>
            <text class="service-feature-title">{{item.title}}</text>
            <text class="service-feature-description">{{item.description}}</text>
            <view class="service-feature-link"><text>进一步了解</text><view class="service-feature-arrow"></view></view>
          </view>
        </swiper-item>
      </swiper>
      <view class="service-feature-dots">
        <view wx:for="{{serviceFeatures}}" wx:key="key" class="service-feature-dot {{featureCurrent === index ? 'service-feature-dot-active' : ''}}"></view>
      </view>
    </view>
    <view style="height: 240rpx;"></view>
  </scroll-view>
</view>
