<view class="container">
  <view class="nav-bar" style="height: {{navBarHeight}}rpx;">
    <view class="nav-back" bindtap="onBack"><view class="back-arrow"></view></view>
    <text class="nav-title">我的订单</text>
  </view>

  <view class="tab-bar" style="top: {{navBarHeight}}rpx;">
    <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'active' : ''}}" bindtap="onTabChange" data-index="{{index}}">
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.key}}"></view>
    </view>
  </view>

  <scroll-view scroll-y class="order-scroll" style="padding-top: {{navBarHeight + 92}}rpx;" enhanced show-scrollbar="{{false}}" bindrefresherrefresh="onRefresh" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}">
    <view class="order-list">
      <view class="section-header">
        <text class="section-title">订单记录</text>
        <text class="section-count">{{displayedOrders.length}} 笔</text>
      </view>

      <view class="order-type-tabs">
        <view wx:for="{{orderTypeTabs}}" wx:key="key" class="order-type-tab {{activeOrderType === item.key ? 'active' : ''}}" bindtap="onOrderTypeChange" data-type="{{item.key}}"><text>{{item.name}}</text></view>
      </view>

      <view wx:if="{{displayedOrders.length > 0}}">
        <view wx:for="{{displayedOrders}}" wx:key="id" class="order-card" bindtap="onOrderTap" data-id="{{item.id}}" data-type="{{item.orderType}}">
          <view class="order-header">
            <text class="order-no">订单号 {{item.order_no || item.id}}</text>
            <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="order-products">
            <image class="product-image" src="{{item.displayImage}}" mode="aspectFill" />
            <view class="product-info">
              <text class="product-name">{{item.displayName}}</text>
              <text class="product-meta">{{item.orderType === 'points' ? '积分兑换' : '商品订单'}} · {{item.quantity}}件</text>
              <text wx:if="{{item.orderType === 'goods'}}" class="product-price">¥{{item.amount}}</text>
              <text wx:else class="product-price">{{item.points}} 积分</text>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-time">{{activeTab === 'completed' ? '完成' : '下单'}} · {{activeTab === 'completed' ? item.completedTime : item.createdTime}}</text>
            <view class="order-actions">
              <view wx:if="{{item.status === 'pending_payment'}}" class="action-btn btn-secondary" catchtap="onCancelOrder" data-id="{{item.id}}" data-type="{{item.orderType}}"><text>取消订单</text></view>
              <view wx:if="{{item.orderType === 'points' && item.status === 'pending_payment' && item.amount > 0}}" class="action-btn btn-primary" catchtap="onPayPointsOrder" data-id="{{item.id}}" data-name="{{item.displayName}}"><text>继续支付</text></view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'paid'}}" class="action-btn btn-secondary" catchtap="onRefundOrder" data-id="{{item.id}}"><text>申请退款</text></view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'refunding'}}" class="action-btn btn-secondary"><text>退款处理中</text></view>
              <view wx:if="{{item.orderType === 'points' && (item.status === 'paid' || item.status === 'pending_send' || item.status === 'cancelled' || item.status === 'shipped' || item.status === 'completed')}}" class="action-btn btn-secondary" catchtap="onApplyPointsRefund" data-id="{{item.id}}"><text>申请退款</text></view>
              <view wx:if="{{item.orderType === 'points' && item.status === 'refunding'}}" class="action-btn btn-secondary"><text>退款审核中</text></view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'shipped'}}" class="action-btn btn-primary" catchtap="onConfirmReceive" data-id="{{item.id}}"><text>确认收货</text></view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'completed'}}" class="action-btn btn-secondary" catchtap="onAfterSaleOrder" data-id="{{item.id}}"><text>申请售后</text></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="section-empty">暂无{{activeOrderType === 'goods' ? '商品订单' : '积分订单'}}</view>

      <view wx:if="{{hasMore}}" class="load-more"><text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text></view>
      <view wx:elif="{{displayedOrders.length > 0}}" class="no-more"><text>没有更多订单</text></view>
    </view>

    <view wx:if="{{!loading && goodsOrders.length === 0 && pointsOrders.length === 0}}" class="empty-state">
      <view class="empty-icon"><view class="icon-package"></view><view class="icon-package-line"></view></view>
      <text class="empty-title">暂无订单</text><text class="empty-desc">快去挑选心仪的商品吧</text>
      <view class="empty-btn" bindtap="onGoShop"><text>去商城</text></view>
    </view>
    <view style="height: 200rpx;"></view>
  </scroll-view>

  <view wx:if="{{loading && orders.length === 0}}" class="loading-state"><view class="loading-spinner"></view><text>加载中...</text></view>
</view>
