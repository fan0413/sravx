<view class="container">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}rpx;">
    <view class="nav-back" bindtap="onBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">我的订单</text>
  </view>

  <!-- 顶部 Tab 切换 -->
  <view class="tab-bar" style="top: {{navBarHeight}}rpx;">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key" 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.key}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view 
    scroll-y 
    class="order-scroll" 
    style="padding-top: {{navBarHeight + 100}}rpx;"
    enhanced 
    show-scrollbar="{{false}}"
    bindrefresherrefresh="onRefresh"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refresherTriggered}}"
  >
    <view class="order-list">
      <!-- 二级类型筛选 -->
      <view class="order-type-tabs">
        <view
          wx:for="{{orderTypeTabs}}"
          wx:key="key"
          class="order-type-tab {{activeOrderType === item.key ? 'active' : ''}}"
          bindtap="onOrderTypeChange"
          data-type="{{item.key}}"
        >
          <text>{{item.name}}</text>
        </view>
      </view>

      <!-- 当前筛选类型标题 -->
      <view class="section-header">
        <text class="section-title">{{activeOrderType === 'goods' ? '商品订单' : '积分订单'}}</text>
        <text class="section-count">{{displayedOrders.length}}单</text>
      </view>

      <!-- 当前筛选列表 -->
      <view wx:if="{{displayedOrders.length > 0}}">
        <view
          wx:for="{{displayedOrders}}"
          wx:key="id"
          class="order-card {{item.orderType === 'points' ? 'points-card' : 'goods-card'}}"
          bindtap="onOrderTap"
          data-id="{{item.id}}"
          data-type="{{item.orderType}}"
        >
          <view class="order-header">
            <text class="order-no">订单号: {{item.order_no || item.id}}</text>
            <text class="order-type-badge {{item.orderType === 'points' ? 'points-badge' : 'goods-badge'}}">{{item.orderType === 'points' ? '积分订单' : '商品订单'}}</text>
          </view>
          <view class="order-products">
            <view class="product-item">
              <image class="product-image" src="{{item.displayImage}}" mode="aspectFill" />
              <view class="product-info">
                <text class="product-name">{{item.displayName}}</text>
                <text class="product-address">状态：{{item.statusText}}</text>
                <text wx:if="{{activeTab === 'completed' && item.orderType === 'goods'}}" class="product-price">金额 ¥{{item.amount}}</text>
                <text wx:if="{{activeTab === 'completed' && item.orderType === 'points'}}" class="product-price">兑换积分 {{item.points}} 积分</text>
                <text wx:if="{{activeTab !== 'completed' && item.status === 'pending_payment'}}" class="product-price">待支付 ¥{{item.amount}}</text>
                <text wx:if="{{activeTab !== 'completed' && (item.status === 'paid' || item.status === 'pending_send')}}" class="product-price">待发货数量 {{item.quantity}}件</text>
                <text wx:if="{{activeTab !== 'completed' && item.status === 'shipped'}}" class="product-price">待收货数量 {{item.quantity}}件</text>
                <text wx:if="{{activeTab !== 'completed' && item.status === 'refunding'}}" class="product-price">退款处理中</text>
                <text wx:if="{{activeTab !== 'completed' && item.status === 'cancelled'}}" class="product-price">订单已取消</text>
                <text wx:if="{{activeTab !== 'completed' && item.status === 'refunded'}}" class="product-price">订单已退款</text>
                <text class="product-progress">{{item.progressHint}}</text>
              </view>
            </view>
          </view>
          <view class="order-footer">
            <text class="order-time">{{activeTab === 'completed' ? ('完成时间：' + item.completedTime) : ('下单时间：' + item.created_at)}}</text>
            <view class="order-actions">
              <view wx:if="{{item.status === 'pending_payment'}}" class="action-btn btn-cancel" catchtap="onCancelOrder" data-id="{{item.id}}" data-type="{{item.orderType}}">
                <text>取消订单</text>
              </view>
              <view wx:if="{{item.orderType === 'points' && item.status === 'pending_payment' && item.amount > 0}}" class="action-btn btn-confirm" catchtap="onPayPointsOrder" data-id="{{item.id}}" data-name="{{item.displayName}}">
                <text>继续支付</text>
              </view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'paid'}}" class="action-btn btn-cancel" catchtap="onRefundOrder" data-id="{{item.id}}">
                <text>申请退款</text>
              </view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'refunding'}}" class="action-btn btn-cancel">
                <text>退款处理中</text>
              </view>
              <view wx:if="{{item.orderType === 'points' && (item.status === 'paid' || item.status === 'pending_send' || item.status === 'cancelled' || item.status === 'shipped' || item.status === 'completed')}}" class="action-btn btn-cancel" catchtap="onApplyPointsRefund" data-id="{{item.id}}">
                <text>申请退款</text>
              </view>
              <view wx:if="{{item.orderType === 'points' && item.status === 'refunding'}}" class="action-btn btn-cancel">
                <text>退款审核中</text>
              </view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'shipped'}}" class="action-btn btn-confirm" catchtap="onConfirmReceive" data-id="{{item.id}}">
                <text>确认收货</text>
              </view>
              <view wx:if="{{item.orderType === 'goods' && item.status === 'completed'}}" class="action-btn btn-cancel" catchtap="onAfterSaleOrder" data-id="{{item.id}}">
                <text>申请售后</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="section-empty">暂无{{activeOrderType === 'goods' ? '商品订单' : '积分订单'}}</view>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="load-more">
        <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
      </view>
      <view wx:elif="{{displayedOrders.length > 0}}" class="no-more">
        <text>— 没有更多订单了 —</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!loading && goodsOrders.length === 0 && pointsOrders.length === 0}}" class="empty-state">
      <view class="empty-icon">
        <view class="icon-package"></view>
        <view class="icon-package-line"></view>
        <view class="icon-package-line"></view>
      </view>
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">快去挑选心仪的商品吧</text>
      <view class="empty-btn" bindtap="onGoShop">
        <text>去商城</text>
      </view>
    </view>

    <view style="height: 200rpx;"></view>
  </scroll-view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && orders.length === 0}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
