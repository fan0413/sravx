.container { height: 100%; background: #F2F2F7; position: relative; }
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: flex-end; padding: 0 24rpx 12rpx; background: rgba(255,255,255,.9); border-bottom: 1rpx solid rgba(0,0,0,.04); backdrop-filter: saturate(180%) blur(40rpx); -webkit-backdrop-filter: saturate(180%) blur(40rpx); }
.nav-back { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-arrow { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--color-primary); border-bottom: 3rpx solid var(--color-primary); transform: rotate(45deg); margin-left: 6rpx; }
.nav-title { flex: 1; margin-right: 64rpx; color: var(--color-primary); font-size: 34rpx; font-weight: 720; text-align: center; }
.tab-bar { position: fixed; left: 0; right: 0; z-index: 99; height: 100rpx; display: flex; align-items: center; background: rgba(255,255,255,.9); border-bottom: 1rpx solid rgba(0,0,0,.04); backdrop-filter: saturate(180%) blur(40rpx); -webkit-backdrop-filter: saturate(180%) blur(40rpx); }
.tab-item { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.tab-text { color: var(--color-secondary); font-size: 27rpx; transition: color .16s ease, transform .16s ease; }
.tab-item:active .tab-text { transform: scale(.95); }
.tab-item.active .tab-text { color: var(--color-primary); font-weight: 650; }
.tab-indicator { position: absolute; bottom: 15rpx; width: 38rpx; height: 5rpx; border-radius: 99rpx; background: var(--color-accent); }
.order-scroll { height: 100%; }
.order-list { padding: 34rpx 28rpx 28rpx; }
.order-type-tabs { display: flex; gap: 0; margin-bottom: 32rpx; padding: 5rpx; border-radius: 18rpx; background: #E7E7EC; }
.order-type-tab { flex: 1; padding: 17rpx 16rpx; border: 1rpx solid transparent; border-radius: 14rpx; color: var(--color-secondary); font-size: 25rpx; text-align: center; transition: transform .16s ease, opacity .16s ease, background .16s ease; }
.order-type-tab:active { transform: scale(.95); opacity: .76; }
.order-type-tab.active { border-color: rgba(0,0,0,.03); background: #FFF; color: var(--color-primary); font-weight: 650; box-shadow: 0 2rpx 8rpx rgba(29,29,31,.08); }
.section-header { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 22rpx; }
.section-title { color: var(--color-primary); font-size: 38rpx; font-weight: 720; letter-spacing: -.6rpx; }
.section-count { color: var(--color-secondary); font-size: 24rpx; }
.section-empty { padding: 72rpx 20rpx; border-radius: 26rpx; background: #FFF; color: var(--color-secondary); font-size: 26rpx; text-align: center; }
.order-card { overflow: hidden; margin-bottom: 22rpx; border-radius: 28rpx; background: #FFF; box-shadow: 0 10rpx 28rpx rgba(29,29,31,.055); }
.order-card:active { opacity: .78; }
.order-header { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 0 28rpx; border-bottom: 1rpx solid var(--color-border); }
.order-no { max-width: 470rpx; color: var(--color-secondary); font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex-shrink: 0; color: var(--color-accent); font-size: 25rpx; font-weight: 650; }
.status-pending { color: #B26A23; }.status-shipped { color: #3075AE; }.status-completed { color: #278A57; }.status-cancelled { color: var(--color-secondary); }
.order-products { display: flex; align-items: center; padding: 26rpx 28rpx; }
.product-image { width: 154rpx; height: 154rpx; flex-shrink: 0; border-radius: 18rpx; background: #ECEDEF; }
.product-info { flex: 1; min-width: 0; min-height: 154rpx; margin-left: 24rpx; display: flex; flex-direction: column; justify-content: center; }
.product-name { color: var(--color-primary); font-size: 29rpx; line-height: 1.38; font-weight: 650; display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.product-meta { display: block; margin-top: 10rpx; color: var(--color-secondary); font-size: 23rpx; }
.product-price { display: block; margin-top: 12rpx; color: var(--color-primary); font-size: 30rpx; font-weight: 700; letter-spacing: -.2rpx; }
.order-footer { min-height: 88rpx; padding: 16rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 1rpx solid var(--color-border); background: #FCFCFD; }
.order-time { flex: 1; color: var(--color-secondary); font-size: 22rpx; }
.order-actions { display: flex; gap: 12rpx; }
.action-btn { min-width: 128rpx; padding: 15rpx 20rpx; border-radius: 99rpx; text-align: center; font-size: 24rpx; font-weight: 600; }
.btn-secondary { border: 1rpx solid #D1D1D6; background: #FFF; color: var(--color-primary); }.btn-primary { background: var(--color-primary); color: #FFF; }
.load-more, .no-more { padding: 34rpx; text-align: center; }.load-more text, .no-more text { color: var(--color-secondary); font-size: 24rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 140rpx 60rpx; }.empty-icon { width: 144rpx; height: 144rpx; margin-bottom: 36rpx; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF; }.icon-package { width: 58rpx; height: 48rpx; position: relative; border: 3rpx solid var(--color-secondary); border-radius: 8rpx; }.icon-package::before { content: ''; position: absolute; top: -10rpx; left: 50%; width: 22rpx; height: 12rpx; border-radius: 4rpx 4rpx 0 0; background: var(--color-secondary); transform: translateX(-50%); }.icon-package-line { position: absolute; width: 3rpx; height: 40rpx; background: var(--color-secondary); left: 50%; transform: translateX(-50%); }.empty-title { margin-bottom: 14rpx; color: var(--color-primary); font-size: 32rpx; font-weight: 650; }.empty-desc { margin-bottom: 42rpx; color: var(--color-secondary); font-size: 26rpx; }.empty-btn { padding: 20rpx 60rpx; border-radius: 99rpx; background: var(--color-primary); }.empty-btn text { color: #FFF; font-size: 28rpx; font-weight: 600; }
.loading-state { position: fixed; top: 50%; left: 50%; display: flex; flex-direction: column; align-items: center; gap: 20rpx; transform: translate(-50%,-50%); }.loading-state text { color: var(--color-secondary); font-size: 26rpx; }.loading-spinner { width: 56rpx; height: 56rpx; border: 4rpx solid var(--color-border); border-top-color: var(--color-accent); border-radius: 50%; animation: spin .8s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
