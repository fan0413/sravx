.container {
  height: 100%;
  background: #F5F5F7;
  position: relative;
}

/* ====== Nav Bar ====== */

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FFFFFF;
  display: flex;
  align-items: flex-end;
  padding: 0 24rpx 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--color-primary);
  border-bottom: 3rpx solid var(--color-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-right: 64rpx;
}

/* ====== Tab Bar ====== */

.tab-bar {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  z-index: 99;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: var(--color-secondary);
  transition: color 0.2s;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 16rpx;
  width: 48rpx;
  height: 6rpx;
  background: var(--color-accent);
  border-radius: 3rpx;
}

/* ====== Order Scroll ====== */

.order-scroll {
  height: 100%;
}

/* ====== Order List ====== */

.order-list {
  padding: 24rpx;
}

.order-type-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 4rpx 20rpx;
}

.order-type-tab {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #666;
  font-size: 24rpx;
  line-height: 1;
}

.order-type-tab.active {
  background: #b8956a;
  color: #fff;
  font-weight: 600;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 4rpx 18rpx;
}

.section-title {
  font-size: 28rpx;
  color: #4a4a4a;
  font-weight: 600;
}

.section-count {
  font-size: 22rpx;
  color: #999;
}

.section-empty {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #aaa;
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 12rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-no {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-type-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.goods-badge {
  background: #f0f7ff;
  color: #2f6feb;
}

.points-badge {
  background: #fff7e8;
  color: #b67900;
}

.status-pending {
  color: #FF9500;
}

.status-shipped {
  color: #007AFF;
}

.status-completed {
  color: var(--color-success);
}

.status-cancelled {
  color: var(--color-secondary);
}

/* ====== Order Products ====== */

.order-products {
  padding: 24rpx 28rpx;
}

.product-item {
  display: flex;
  align-items: center;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--color-bg-secondary);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 140rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-address {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: var(--color-accent);
  font-weight: 700;
}

.product-progress {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a8a8a;
}

/* ====== Order Footer ====== */

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #FAFAFA;
}

.order-time {
  font-size: 22rpx;
  color: var(--color-secondary);
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-cancel {
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  color: var(--color-secondary);
}

.btn-confirm {
  background: var(--color-accent);
  color: #FFFFFF;
}

/* ====== Load More ====== */

.load-more {
  text-align: center;
  padding: 32rpx;
}

.load-more text {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.no-more {
  text-align: center;
  padding: 32rpx;
}

.no-more text {
  font-size: 24rpx;
  color: var(--color-secondary);
}

/* ====== Empty State ====== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--color-bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 40rpx;
}

.icon-package {
  width: 60rpx;
  height: 50rpx;
  border: 4rpx solid var(--color-secondary);
  border-radius: 8rpx;
  position: relative;
}

.icon-package::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 12rpx;
  background: var(--color-secondary);
  border-radius: 4rpx 4rpx 0 0;
}

.icon-package-line {
  position: absolute;
  width: 4rpx;
  height: 50rpx;
  background: var(--color-secondary);
  left: 50%;
  transform: translateX(-50%);
}

.icon-package-line:first-of-type {
  height: 20rpx;
  top: -2rpx;
}

.icon-package-line:last-of-type {
  display: none;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-secondary);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: var(--color-accent);
  border-radius: 40rpx;
}

.empty-btn text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ====== Loading State ====== */

.loading-state {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-state text {
  font-size: 26rpx;
  color: var(--color-secondary);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
