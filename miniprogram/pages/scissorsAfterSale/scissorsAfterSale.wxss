.page { min-height: 100vh; padding: 24rpx 28rpx 56rpx; box-sizing: border-box; background: #F2F2F7; }
.loading, .empty { padding: 96rpx 0; text-align: center; color: #636366; font-size: 28rpx; }
.scissors-card, .panel, .record-panel { background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .05); }
.scissors-card { display: flex; overflow: hidden; }
.scissors-image { width: 214rpx; height: 214rpx; background: #ececee; flex-shrink: 0; }
.scissors-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; padding: 24rpx; min-width: 0; }
.scissors-name { color: #161616; font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.scissors-sn, .warranty, .hint, .record-time, .waiting-message { margin-top: 12rpx; color: #636366; font-size: 24rpx; }
.scissors-sn { font-family: monospace; color: #555; }
.section-title { margin: 40rpx 4rpx 18rpx; color: #161616; font-size: 30rpx; font-weight: 600; }
.panel { padding: 26rpx; }
.type-row { display: flex; gap: 18rpx; }
.type-option { flex: 1; padding: 18rpx 0; text-align: center; border: 2rpx solid #e5e5ea; border-radius: 14rpx; color: #666; font-size: 28rpx; }
.type-option.selected { color: #a77a45; border-color: #b8956a; background: #fbf6ef; font-weight: 600; }
.description { width: 100%; height: 210rpx; margin-top: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #f7f7f8; color: #161616; font-size: 27rpx; line-height: 1.5; }
.submit-button { height: 84rpx; margin-top: 22rpx; border-radius: 42rpx; background: #b8956a; color: #fff; text-align: center; line-height: 84rpx; font-size: 29rpx; font-weight: 600; }
.submit-button.disabled { opacity: .55; }
.hint { display: block; line-height: 1.5; }
.address-title, .address-row { display: flex; justify-content: space-between; align-items: center; }
.address-title { margin-top: 22rpx; color: #333; font-size: 26rpx; font-weight: 600; }
.manage-link { color: #b8956a; font-size: 24rpx; font-weight: 400; }
.address-empty, .address-item { margin-top: 14rpx; padding: 18rpx; border-radius: 14rpx; background: #f7f7f8; color: #555; font-size: 24rpx; line-height: 1.5; }
.address-item.selected { border: 2rpx solid #b8956a; background: #fbf6ef; }
.shipment-panel { margin-top: 24rpx; }
.shipment-title { display: block; color: #161616; font-size: 29rpx; font-weight: 600; }
.shipment-address, .logistics, .coupon-note { display: block; margin-top: 12rpx; color: #666; font-size: 24rpx; line-height: 1.5; }
.coupon-note { color: #a77a45; }
.form-input { height: 80rpx; margin-top: 16rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 12rpx; background: #f7f7f8; color: #161616; font-size: 26rpx; }
.record-panel { padding: 26rpx; margin-bottom: 20rpx; }
.record-head, .message-meta { display: flex; justify-content: space-between; align-items: center; }
.record-type { color: #161616; font-size: 29rpx; font-weight: 600; }
.record-status { color: #b8956a; font-size: 25rpx; font-weight: 600; }
.record-desc { display: block; margin-top: 16rpx; color: #4a4a4a; font-size: 27rpx; line-height: 1.55; }
.record-time { display: block; }
.message-list { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f0f0; }
.message { margin-top: 16rpx; padding: 18rpx; border-radius: 14rpx; background: #f7f7f8; }
.message.seller { background: #fbf6ef; }
.message-meta { color: #8e8e93; font-size: 22rpx; }
.message-content { display: block; margin-top: 10rpx; color: #333; font-size: 26rpx; line-height: 1.5; }
