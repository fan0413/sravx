.page { min-height: 100vh; padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 56rpx); box-sizing: border-box; background: #F2F2F7; }
.loading, .empty { padding: 96rpx 0; text-align: center; color: var(--color-secondary); font-size: 28rpx; }
.device-hero { display: flex; flex-direction: column; align-items: center; padding: 30rpx 32rpx 52rpx; }
.device-image-wrap { width: 264rpx; height: 264rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; background: #FFF; box-shadow: 0 12rpx 32rpx rgba(29,29,31,.06); overflow: hidden; }
.device-image { width: 100%; height: 100%; }
.device-name { display: block; margin-top: 28rpx; color: var(--color-primary); font-size: 42rpx; line-height: 1.25; font-weight: 720; letter-spacing: -.8rpx; text-align: center; }
.device-model { display: block; margin-top: 10rpx; color: var(--color-secondary); font-size: 28rpx; line-height: 1.4; text-align: center; }
.archive-heading, .section-title { margin: 0 4rpx 18rpx; color: var(--color-secondary); font-size: 27rpx; font-weight: 500; }
.device-info-card, .panel, .record-panel { background: #FFF; border-radius: 26rpx; box-shadow: 0 8rpx 28rpx rgba(29,29,31,.05); overflow: hidden; }
.device-info-row { min-height: 100rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 1rpx solid var(--color-border); }
.device-info-row:last-child { border-bottom: 0; }
.device-info-label { flex-shrink: 0; color: var(--color-primary); font-size: 30rpx; font-weight: 500; }
.device-info-value { max-width: 470rpx; color: var(--color-secondary); font-size: 27rpx; line-height: 1.35; text-align: right; }
.sn-value { font-family: 'SF Mono', 'Menlo', monospace; letter-spacing: .8rpx; color: var(--color-primary); }
.warranty-value { color: var(--color-accent); font-weight: 600; }
.section-title { margin-top: 48rpx; color: var(--color-primary); font-size: 34rpx; font-weight: 720; letter-spacing: -.4rpx; }
.panel { padding: 28rpx; }
.type-row { display: flex; gap: 18rpx; }
.type-option { flex: 1; padding: 20rpx 0; text-align: center; border: 2rpx solid var(--color-border); border-radius: 18rpx; color: var(--color-secondary); font-size: 28rpx; }
.type-option.selected { color: #FFF; border-color: var(--color-primary); background: var(--color-primary); font-weight: 650; }
.description { width: 100%; height: 210rpx; margin-top: 24rpx; padding: 22rpx; box-sizing: border-box; border-radius: 18rpx; background: #F2F2F7; color: var(--color-primary); font-size: 27rpx; line-height: 1.5; }
.submit-button { height: 88rpx; margin-top: 24rpx; border-radius: 44rpx; background: var(--color-primary); color: #FFF; text-align: center; line-height: 88rpx; font-size: 29rpx; font-weight: 650; }
.submit-button.disabled { opacity: .55; }
.hint, .record-time, .waiting-message { display: block; margin-top: 14rpx; color: var(--color-secondary); font-size: 24rpx; line-height: 1.55; }
.address-title, .address-row { display: flex; justify-content: space-between; align-items: center; }
.address-title { margin-top: 24rpx; color: var(--color-primary); font-size: 27rpx; font-weight: 600; }
.manage-link { color: var(--color-accent); font-size: 24rpx; font-weight: 500; }
.address-empty, .address-item { margin-top: 14rpx; padding: 18rpx; border-radius: 16rpx; background: #F2F2F7; color: var(--color-secondary); font-size: 24rpx; line-height: 1.5; }
.address-item.selected { border: 2rpx solid var(--color-accent); background: #F7F5F2; }
.shipment-panel { margin-top: 24rpx; }
.shipment-title { display: block; color: var(--color-primary); font-size: 29rpx; font-weight: 650; }
.shipment-address, .logistics, .coupon-note { display: block; margin-top: 12rpx; color: var(--color-secondary); font-size: 24rpx; line-height: 1.5; }
.coupon-note { color: var(--color-accent); }
.form-input { height: 82rpx; margin-top: 16rpx; padding: 0 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #F2F2F7; color: var(--color-primary); font-size: 26rpx; }
.record-panel { padding: 28rpx; margin-bottom: 20rpx; }
.record-head, .message-meta { display: flex; justify-content: space-between; align-items: center; }
.record-type { color: var(--color-primary); font-size: 29rpx; font-weight: 650; }
.record-status { color: var(--color-accent); font-size: 25rpx; font-weight: 650; }
.record-desc { display: block; margin-top: 16rpx; color: #3A3A3C; font-size: 27rpx; line-height: 1.55; }
.message-list { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); }
.message { margin-top: 16rpx; padding: 18rpx; border-radius: 16rpx; background: #F2F2F7; }
.message.seller { background: #F7F5F2; }
.message-meta { color: #8E8E93; font-size: 22rpx; }
.message-content { display: block; margin-top: 10rpx; color: var(--color-primary); font-size: 26rpx; line-height: 1.5; }
