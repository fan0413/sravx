.container {
  min-height: 100%;
  background: var(--color-bg-secondary);
}

.status-placeholder {
}

/* ====== User Header ====== */

.profile-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.user-header {
  display: flex;
  align-items: center;
  padding: 34rpx 36rpx 30rpx;
  background: transparent;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-bg-secondary);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.user-meta {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  max-width: 100%;
  align-self: flex-start;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-icon {
  width: 26rpx;
  height: 26rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
  position: relative;
}

.edit-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 12rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--color-accent);
  transform: rotate(-45deg);
}

.edit-icon::after {
  content: '';
  position: absolute;
  right: 2rpx;
  top: 4rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: var(--color-accent);
  transform: rotate(-45deg);
}

.tap-fade {
  opacity: 0.7;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx 0 10rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  align-self: flex-start;
  box-shadow: none;
}

.member-badge-mark {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}

.level-normal {
  background: #F1F1F3;
  border-color: #D8D8DC;
  color: #515154;
}

.level-silver {
  background: #E3E3E6;
  border-color: #CDCDD2;
  color: #4E4E54;
}

.level-gold {
  background: #EEE9DF;
  border-color: #D6C7AF;
  color: #4D443C;
}

.level-diamond {
  background: #3B3D42;
  border-color: #56585D;
  color: #F0EFEA;
}

.level-black-diamond {
  background: #161616;
  border-color: #6E6256;
  color: #F3EBDD;
  box-shadow: 0 6rpx 16rpx rgba(29, 29, 31, 0.16);
}

.level-supreme {
  background: #111112;
  border-color: #C8AE7D;
  color: #F6ECD8;
  box-shadow: 0 6rpx 18rpx rgba(29, 29, 31, 0.2);
}

.member-badge-label {
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 1.8rpx;
  color: currentColor;
}

.member-badge-level {
  margin-left: 8rpx;
  padding-left: 8rpx;
  border-left: 1rpx solid currentColor;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: currentColor;
}

/* ====== Asset Card ====== */

.asset-card {
  display: flex;
  margin: 0 36rpx;
  padding: 30rpx 0 32rpx;
  border-top: 1rpx solid var(--color-border);
  background: transparent;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.asset-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.asset-label {
  font-size: 24rpx;
  color: var(--color-secondary);
  font-weight: 300;
}

.asset-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
  align-self: center;
}

/* ====== Sections ====== */

.section {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.section-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #C7C7CC;
  border-bottom: 2rpx solid #C7C7CC;
  transform: rotate(-45deg);
}

/* ====== Scissors Preview ====== */

.scissors-preview {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.preview-card { overflow: hidden; border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 12rpx 28rpx rgba(29,29,31,.06); }
.preview-card:active { opacity: .78; }
.preview-surface { width: 100%; height: 392rpx; overflow: hidden; background: #ECEDEF; }
.preview-bg { width: 100%; height: 100%; }
.preview-summary { padding: 26rpx 28rpx 28rpx; background: #FFFFFF; }
.preview-name { display: block; color: var(--color-primary); font-size: 32rpx; font-weight: 700; letter-spacing: -.5rpx; }

/* more link */

.preview-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  gap: 6rpx;
}

.preview-more text {
  font-size: 26rpx;
  color: var(--color-accent);
  font-weight: 500;
}

.scissors-empty {
  padding: 32rpx 0;
  text-align: center;
}

.scissors-empty text {
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 300;
}

/* ====== Menu Section ====== */

.menu-section {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #fff;
}

.menu-section button.menu-item {
  width: 100%;
  border-radius: 0;
  text-align: left;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-pin {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  position: absolute;
  top: 4rpx;
  left: 8rpx;
}

.icon-pin::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-chat {
  width: 28rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 6rpx;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
}

.icon-gift {
  width: 28rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 5rpx;
  position: absolute;
  left: 4rpx;
  bottom: 2rpx;
}

.icon-gift::before {
  content: '';
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -10rpx;
  height: 10rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 5rpx 5rpx 2rpx 2rpx;
}

.icon-gift::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: -10rpx;
  bottom: -2rpx;
  width: 2rpx;
  background: var(--color-accent);
}

.icon-headset {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 6rpx;
}

.icon-headset::after {
  content: '';
  width: 32rpx;
  height: 6rpx;
  border-top: 2rpx solid var(--color-accent);
  border-radius: 16rpx 16rpx 0 0;
  position: absolute;
  top: -8rpx;
  left: -6rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 400;
}
