.container {
  min-height: 100%;
  background: var(--color-bg-secondary);
  padding-bottom: 120rpx;
}

.form-scroll {
  padding: 24rpx 32rpx;
}

/* ====== Form Group ====== */

.form-group {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: 20rpx;
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

/* ====== Input ====== */

.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* ====== Picker ====== */

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  font-size: 28rpx;
  color: #C7C7CC;
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.picker-filled text {
  color: var(--color-primary);
}

.picker-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #C7C7CC;
  border-bottom: 2rpx solid #C7C7CC;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ====== Textarea ====== */

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ====== Submit ====== */

.submit-area {
  margin-top: 32rpx;
  padding: 0 4rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--color-accent);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.btn-disabled {
  opacity: 0.5;
}

/* ====== Confirm Modal ====== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.modal-card {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 44rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.modal-body {
  flex: 1;
  max-height: 56vh;
}

.confirm-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.confirm-label {
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 300;
  width: 130rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.confirm-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.4;
}

.confirm-address {
  font-weight: 400;
  word-break: break-all;
}

.confirm-intention {
  border-bottom: none;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  flex-shrink: 0;
}

.confirm-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-bg-secondary);
}

.confirm-cancel text {
  font-size: 30rpx;
  color: var(--color-secondary);
  font-weight: 400;
}

.confirm-submit {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--color-accent);
  transition: opacity 0.2s;
}

.confirm-submit text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.confirm-submit:active {
  opacity: 0.85;
}
