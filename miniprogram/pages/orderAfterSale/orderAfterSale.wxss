.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 20rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: #86868b;
  padding: 0 8rpx 16rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.type {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  color: #b8956a;
  font-weight: 600;
}

.reason {
  margin: 14rpx 0;
  font-size: 24rpx;
  color: #666;
}

.time {
  font-size: 22rpx;
  color: #8e8e93;
}

.amount {
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.reason-input {
  margin-top: 16rpx;
  width: 100%;
  min-height: 140rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #1d1d1f;
}

.submit-btn {
  margin-top: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background: #b8956a;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  opacity: 0.6;
}
