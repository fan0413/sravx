.page {
  min-height: 100vh;
  background: var(--color-bg-secondary);
  padding: 24rpx 32rpx 56rpx;
}

.gift-card {
  position: relative;
  min-height: 320rpx;
  border-radius: 24rpx;
  padding: 34rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #1d1d1f 0%, #3c3328 56%, #b8956a 100%);
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-shine {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.card-head,
.card-bottom {
  position: relative;
  z-index: 2;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.card-kicker {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.68);
  font-weight: 500;
}

.card-title {
  display: block;
  margin-top: 12rpx;
  font-size: 42rpx;
  color: #ffffff;
  font-weight: 700;
}

.card-mark {
  flex-shrink: 0;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0;
  font-weight: 700;
}

.card-code {
  display: block;
  font-family: 'SF Mono', 'Menlo', monospace;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 0;
  word-break: break-all;
}

.card-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

.redeem-panel,
.rules-section,
.records-section,
.result-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

.panel-title,
.section-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.input-wrap {
  margin-top: 24rpx;
  height: 96rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.input-wrap.has-value {
  border-color: rgba(184, 149, 106, 0.45);
}

.code-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 24rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
  font-size: 30rpx;
  color: var(--color-primary);
  letter-spacing: 0;
}

.clear-btn {
  width: 76rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-btn text {
  font-size: 40rpx;
  color: #c7c7cc;
  line-height: 1;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quick-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--color-bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.quick-btn text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.quick-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.paste-icon {
  border: 2rpx solid var(--color-accent);
  border-radius: 4rpx;
}

.paste-icon::before {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: -7rpx;
  height: 8rpx;
  border: 2rpx solid var(--color-accent);
  border-radius: 5rpx;
  background: var(--color-bg-secondary);
}

.scan-icon {
  border: 2rpx solid var(--color-accent);
  border-radius: 4rpx;
}

.scan-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 12rpx;
  height: 2rpx;
  background: var(--color-accent);
}

.redeem-btn {
  margin-top: 26rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: var(--color-accent);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.redeem-btn.disabled {
  opacity: 0.42;
}

.result-card {
  border-left: 8rpx solid var(--color-success);
}

.result-card.error {
  border-left-color: var(--color-danger);
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.result-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-secondary);
}

.address-box {
  margin-top: 22rpx;
  min-height: 104rpx;
  border-radius: 16rpx;
  background: var(--color-bg-secondary);
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.address-detail {
  display: block;
  font-size: 25rpx;
  color: var(--color-primary);
  line-height: 1.35;
}

.address-meta,
.address-placeholder {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-secondary);
}

.address-placeholder {
  flex: 1;
  margin-top: 0;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #c7c7cc;
  border-bottom: 2rpx solid #c7c7cc;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

.result-action {
  margin-top: 22rpx;
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.rule-row {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.rule-index {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(184, 149, 106, 0.12);
  color: var(--color-accent);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.rule-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-secondary);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-count {
  font-size: 22rpx;
  color: var(--color-secondary);
}

.record-list {
  margin-top: 18rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record-item:last-child {
  border-bottom: none;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.record-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-secondary);
}

.record-value {
  display: block;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-accent);
  font-weight: 600;
}

.record-side {
  flex-shrink: 0;
  text-align: right;
}

.record-action-text {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-secondary);
}

.empty-record {
  margin-top: 22rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: var(--color-bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-record text {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.contact-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
}

.contact-row text,
.contact-link {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.contact-link {
  color: var(--color-accent);
  line-height: 1.4;
}
