.page { min-height: 100vh; padding: 38rpx 28rpx calc(env(safe-area-inset-bottom) + 160rpx); background: #F2F2F7; box-sizing: border-box; }
.bag-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 28rpx; }.bag-title { color: var(--color-primary); font-size: 48rpx; font-weight: 720; letter-spacing: -1rpx; }.bag-count { color: var(--color-secondary); font-size: 25rpx; }
.bag-list { display: flex; flex-direction: column; gap: 18rpx; }.bag-card { position: relative; display: flex; min-height: 210rpx; padding: 22rpx; border-radius: 26rpx; background: #FFF; box-shadow: 0 10rpx 28rpx rgba(29,29,31,.055); }.bag-image { width: 166rpx; height: 166rpx; flex-shrink: 0; border-radius: 18rpx; background: #ECEDEF; }.bag-info { min-width: 0; flex: 1; margin-left: 22rpx; padding-right: 6rpx; display: flex; flex-direction: column; }.bag-name { color: var(--color-primary); font-size: 28rpx; line-height: 1.35; font-weight: 650; }.bag-spec { display: block; margin-top: 8rpx; color: var(--color-secondary); font-size: 23rpx; }.bag-price { display: block; margin-top: 12rpx; color: var(--color-primary); font-size: 29rpx; font-weight: 700; }.bag-actions { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }.quantity-stepper { display: flex; align-items: center; border-radius: 99rpx; background: #F2F2F7; overflow: hidden; }.quantity-button { width: 48rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 28rpx; }.quantity-button:active { opacity: .55; }.quantity-value { min-width: 42rpx; color: var(--color-primary); font-size: 24rpx; text-align: center; }.remove-link { margin-right: 14rpx; color: var(--color-secondary); font-size: 23rpx; }.checkout-button { position: absolute; right: 22rpx; top: 22rpx; min-width: 94rpx; padding: 12rpx 16rpx; border-radius: 99rpx; background: var(--color-primary); color: #FFF; font-size: 23rpx; font-weight: 650; text-align: center; }.checkout-button:active { opacity: .75; }.bag-total { margin-top: 24rpx; padding: 28rpx; display: flex; justify-content: space-between; border-radius: 22rpx; background: #F8F5F0; color: var(--color-primary); font-size: 28rpx; font-weight: 650; }.empty-state { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 80rpx; }.bag-icon { width: 148rpx; height: 148rpx; margin-bottom: 34rpx; position: relative; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFF; }.bag-shape { width: 62rpx; height: 56rpx; margin-top: 14rpx; border: 3rpx solid var(--color-secondary); border-radius: 0 0 13rpx 13rpx; }.bag-handle { position: absolute; top: 36rpx; width: 32rpx; height: 22rpx; border: 3rpx solid var(--color-secondary); border-bottom: 0; border-radius: 22rpx 22rpx 0 0; }.empty-title { color: var(--color-primary); font-size: 34rpx; font-weight: 650; }.empty-desc { margin-top: 14rpx; color: var(--color-secondary); font-size: 26rpx; }.go-products { margin-top: 42rpx; padding: 21rpx 52rpx; border-radius: 99rpx; background: var(--color-primary); color: #FFF; font-size: 28rpx; font-weight: 600; }
