.tab-bar {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 10rpx;
  transition: all 0.2s ease;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 20rpx;
  color: #86868B;
  font-weight: 400;
  letter-spacing: 1rpx;
  transition: color 0.2s ease;
}

.label-active {
  color: #1D1D1F;
  font-weight: 500;
}

/* ====== Home Icon ====== */
.icon-home {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.home-outline {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #86868B;
  border-radius: 6rpx 6rpx 0 0;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

.home-door {
  width: 12rpx;
  height: 14rpx;
  border: 2rpx solid #86868B;
  border-radius: 6rpx 6rpx 0 0;
  border-bottom: none;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-active .home-outline {
  border-color: #1D1D1F;
}

.icon-active .home-door {
  border-color: #1D1D1F;
}

/* ====== Shop Icon ====== */
.icon-shop {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-grid {
  width: 36rpx;
  height: 36rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 6rpx;
}

.shop-dot {
  border-radius: 6rpx;
  border: 2rpx solid #86868B;
  background: transparent;
}

.icon-active .shop-dot {
  border-color: #1D1D1F;
}

/* ====== User Icon ====== */
.icon-user {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.user-head {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #86868B;
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.user-body {
  width: 30rpx;
  height: 16rpx;
  border: 2rpx solid #86868B;
  border-radius: 16rpx 16rpx 0 0;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  border-bottom: none;
}

.icon-active .user-head {
  border-color: #1D1D1F;
}

.icon-active .user-body {
  border-color: #1D1D1F;
}

/* ====== Order Icon ====== */
.icon-order {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.order-bag {
  width: 36rpx;
  height: 32rpx;
  border: 2rpx solid #86868B;
  border-radius: 0 0 8rpx 8rpx;
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.order-flap {
  width: 20rpx;
  height: 10rpx;
  border: 2rpx solid #86868B;
  border-radius: 10rpx 10rpx 0 0;
  border-bottom: none;
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

.icon-active .order-bag {
  border-color: #1D1D1F;
}

.icon-active .order-flap {
  border-color: #1D1D1F;
}

.phone-auth-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
}

.phone-auth-panel {
  width: 100%;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.phone-auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.phone-auth-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6E6E73;
}

.phone-auth-button {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.phone-auth-button::after {
  border: none;
}

.phone-auth-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #86868B;
}
