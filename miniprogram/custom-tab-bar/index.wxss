.tab-bar {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 116rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
  box-shadow: 0 -8rpx 28rpx rgba(29, 29, 31, 0.05);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 8rpx;
  transition: all 0.2s ease;
}

.icon-wrap {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 5rpx;
}

.tab-label {
  font-size: 22rpx;
  color: #515154;
  font-weight: 500;
  letter-spacing: .5rpx;
  transition: color 0.2s ease;
}

.label-active {
  color: #161616;
  font-weight: 650;
}

/* ====== Product Home Icon ====== */
.icon-home { width: 44rpx; height: 44rpx; position: relative; }
.home-product { width: 34rpx; height: 28rpx; position: absolute; bottom: 4rpx; left: 50%; border: 2rpx solid #636366; border-radius: 8rpx; transform: translateX(-50%); }
.home-product-detail { width: 14rpx; height: 14rpx; position: absolute; top: 10rpx; left: 50%; border: 2rpx solid #636366; border-radius: 4rpx; transform: translateX(-50%); }
.icon-active .home-product, .icon-active .home-product-detail { border-color: #161616; border-width: 3rpx; }

/* ====== Shopping Bag Icon ====== */
.icon-bag { width: 44rpx; height: 44rpx; position: relative; }
.bag-outline { width: 32rpx; height: 28rpx; position: absolute; bottom: 3rpx; left: 50%; border: 2rpx solid #636366; border-radius: 0 0 8rpx 8rpx; transform: translateX(-50%); }
.bag-handle { width: 18rpx; height: 11rpx; position: absolute; top: 8rpx; left: 50%; border: 2rpx solid #636366; border-bottom: none; border-radius: 12rpx 12rpx 0 0; transform: translateX(-50%); }
.icon-active .bag-outline, .icon-active .bag-handle { border-color: #161616; border-width: 3rpx; }

/* ====== User Icon ====== */
.icon-user {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.user-head {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #636366;
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.user-body {
  width: 30rpx;
  height: 16rpx;
  border: 2rpx solid #636366;
  border-radius: 16rpx 16rpx 0 0;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  border-bottom: none;
}

.icon-active .user-head {
  border-color: #161616;
  border-width: 3rpx;
}

.icon-active .user-body {
  border-color: #161616;
  border-width: 3rpx;
}

/* ====== Order Document Icon ====== */
.icon-order { width: 44rpx; height: 44rpx; position: relative; }
.order-document { width: 29rpx; height: 34rpx; position: absolute; top: 4rpx; left: 50%; border: 2rpx solid #636366; border-radius: 6rpx; transform: translateX(-50%); }
.order-line { width: 14rpx; height: 2rpx; position: absolute; left: 50%; background: #636366; border-radius: 99rpx; transform: translateX(-50%); }
.order-line-first { top: 16rpx; }.order-line-second { top: 24rpx; width: 10rpx; }
.icon-active .order-document { border-color: #161616; border-width: 3rpx; }.icon-active .order-line { background: #161616; height: 3rpx; }
.phone-auth-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
}

.phone-auth-panel {
  width: 100%;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.phone-auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #161616;
}

.phone-auth-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #515154;
}

.phone-auth-button {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #161616;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.phone-auth-button::after {
  border: none;
}

.phone-auth-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #636366;
}
