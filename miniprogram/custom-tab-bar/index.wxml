<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{active === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view wx:if="{{item.icon === 'home'}}" class="icon-wrap">
      <view class="icon-home {{active === index ? 'icon-active' : ''}}">
        <view class="home-product"></view>
        <view class="home-product-detail"></view>
      </view>
    </view>

    <view wx:elif="{{item.icon === 'bag'}}" class="icon-wrap">
      <view class="icon-bag {{active === index ? 'icon-active' : ''}}">
        <view class="bag-outline"></view>
        <view class="bag-handle"></view>
      </view>
    </view>

    <view wx:elif="{{item.icon === 'order'}}" class="icon-wrap">
      <view class="icon-order {{active === index ? 'icon-active' : ''}}">
        <view class="order-document"></view>
        <view class="order-line order-line-first"></view>
        <view class="order-line order-line-second"></view>
      </view>
    </view>

    <view wx:elif="{{item.icon === 'user'}}" class="icon-wrap">
      <view class="icon-user {{active === index ? 'icon-active' : ''}}">
        <view class="user-head"></view>
        <view class="user-body"></view>
      </view>
    </view>

    <text class="tab-label {{active === index ? 'label-active' : ''}}">{{item.text}}</text>
  </view>
</view>
